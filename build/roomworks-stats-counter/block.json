{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "create-block/roomworks-stats-counter",
  "version": "1.0.0",
  "title": "Roomworks Stats Counter",
  "category": "widgets",
  "icon": "chart-bar",
  "description": "Displays live counts of members, listed businesses and UK cities covered.",
  "example": {},
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ]
  },
  "attributes": {
    "membersLabel": {
      "type": "string",
      "default": "Members"
    },
    "membersSuffix": {
      "type": "string",
      "default": ""
    },
    "businessesLabel": {
      "type": "string",
      "default": "Businesses Listed"
    },
    "businessesSuffix": {
      "type": "string",
      "default": "+"
    },
    "citiesLabel": {
      "type": "string",
      "default": "UK Cities"
    },
    "citiesSuffix": {
      "type": "string",
      "default": "+"
    }
  },
  "textdomain": "roomworks-stats-counter",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}